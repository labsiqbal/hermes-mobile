[Unit]
Description=Hermes Bot Mode relay daemon (headless cross-connection A2A relay)
After=network-online.target hermes-dashboard.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.hermes/hermes-agent/venv/bin/python %h/workspace/personal/hermes-mobile/relay-daemon/relay_daemon.py
WorkingDirectory=%h/.hermes
Environment="HERMES_HOME=%h/.hermes"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
